# API de produção. Só é utilizada pelo servidor Next.js, nunca pelo browser.
FILESERVICE_API_URL=https://portal.pumangol.co.ao/ficheiros

# URL pública, apresentada na página de configuração (não é segredo).
FILESERVICE_PUBLIC_URL=https://portal.pumangol.co.ao/ficheiros

# Segredo aleatório de pelo menos 32 caracteres para cifrar o cookie de sessão.
# Gere com: openssl rand -base64 48
DASHBOARD_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
