# /etc/fileservice/fileservice.env
# Permissões: root:fileservice, modo 640. Este ficheiro contém segredos: não vai para o Git.
# Formato systemd: CHAVE=valor, um por linha; comentários só em linhas próprias.

# --- Rede -------------------------------------------------------------------
# Porta local do serviço. O Nginx faz de proxy para aqui.
FILESERVICE_PORT=18085
# Escuta apenas em localhost: o acesso de fora passa sempre pelo Nginx (HTTPS).
SERVER_ADDRESS=127.0.0.1
# URL público, usado para construir os links devolvidos às aplicações.
FILESERVICE_PUBLIC_BASE_URL=https://portal.pumangol.co.ao/ficheiros

# --- Armazenamento ----------------------------------------------------------
# Pasta raiz dos ficheiros. Se mudar, actualizar ReadWritePaths em fileservice.service.
FILESERVICE_STORAGE_PATH=/var/lib/fileservice/storage

# --- Base de dados ----------------------------------------------------------
FILESERVICE_DB_URL=jdbc:postgresql://localhost:5432/fileservice
FILESERVICE_DB_USER=fileservice
FILESERVICE_DB_PASSWORD=TROCAR_ESTA_PASSWORD

# --- Segredos ---------------------------------------------------------------
# Chave de administração (cabeçalho X-Admin-Key), mínimo 24 caracteres.
# Gerar com:  openssl rand -base64 36
FILESERVICE_ADMIN_KEY=
# Segredo HMAC dos links temporários, mínimo 32 caracteres. Mudar este valor invalida
# todos os links emitidos. Gerar com:  openssl rand -base64 48
FILESERVICE_SIGNING_SECRET=

# --- JVM --------------------------------------------------------------------
JAVA_OPTS=-Xms256m -Xmx512m
